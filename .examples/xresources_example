!--------------------------------------------------------------------------
! .xresources_example
!	Settings for terminals. Note that those settings should be merged
!	with the default values by calling xrdb -merge/-load ~/file in
!	to ensure correct initialization.
!
!	Note that xrdb needs package xorg-xrdb.
!
!	Copyright (C) 2010-2026, Michael Paquier
!--------------------------------------------------------------------------

! Settings for urxvt
! Geometry and fonts
URxvt.geometry:           80x32

! Colours
URxvt.foreground:         Black
URxvt.background:         White
URxvt.cursorColor:        #dc74d1
! Text under the cursor; defaults to background (white), which is
! only ~2.8:1 against the pink above.
URxvt.cursorColor2:       Black

! Scrolling
URxvt.saveLines:          10000
URxvt.scrollBar:          true
URxvt.scrollBar_right:    true
URxvt.scrollTtyKeypress:  true
URxvt.scrollTtyOutput:    false
! Only has an effect while scrollTtyOutput is false.
URxvt.scrollWithBuffer:   true
URxvt.jumpScroll:         true
! skipScroll defaults to true and may drop frames under heavy output.
! Uncomment to force every line to be drawn.
!URxvt.skipScroll:        false
